GOOGLE_API_KEYS=clave_1,clave_2,clave_3
# o bien:
# GOOGLE_API_KEY_1=clave_1
# GOOGLE_API_KEY_2=clave_2
# GOOGLE_API_KEY=clave_legacy

# Limita los tokens de salida para ahorrar cuota (por defecto 512)
MAX_OUTPUT_TOKENS=512

# --- Caché de respuestas (ahorra tokens en preguntas repetidas) ---
CACHE_ENABLED=true
CACHE_FILE=respuestas_cache.json
CACHE_SEED_FILE=respuestas_precargadas.json
MAX_CACHE_ENTRIES=200
CACHE_SIMILARITY_THRESHOLD=0.85
